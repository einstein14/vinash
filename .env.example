# Local development (default if unset)
DATABASE_URL=sqlite:///./data/vinash.db

# Production (set in FastAPI Cloud secrets, not here)
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/neondb?sslmode=require

VINASH_ENV=development
VINASH_COOKIE_NAME=vinash_anon
VINASH_COOKIE_MAX_AGE=31536000
VINASH_MAX_THOUGHT_CHARS=20000
VINASH_MAX_ACTION_CHARS=2000
